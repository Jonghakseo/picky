    "settings.remote.cloudflare.mode.custom": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My domain"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 도메인"
          }
        }
      }
    },
    "settings.remote.cloudflare.mode.quick.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picky opens a temporary Cloudflare tunnel; no account needed. The address changes whenever the tunnel opens again, including after Picky restarts. Then pair your phone again, and add the Home Screen app and turn on notifications again from the new address."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 없이 Picky가 Cloudflare 임시 터널을 열어요. Picky를 다시 시작하는 등 터널이 다시 열리면 주소가 바뀌어요. 그때는 폰을 다시 연결하고, 홈 화면 앱과 알림도 새 주소에서 다시 설정해 주세요."
          }
        }
      }
    },
    "settings.remote.cloudflare.mode.custom.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a Cloudflare Tunnel you run on your own domain. Its address doesn't change."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 도메인에서 직접 실행하는 Cloudflare Tunnel을 써요. 주소가 바뀌지 않아요."
          }
        }
      }
    },
    "settings.remote.cloudflare.quick.address": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
