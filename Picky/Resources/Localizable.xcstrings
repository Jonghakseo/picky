    },
    "settings.field.pickyCwd.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to captured Picky context and the next Picky session."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처되는 Picky 컨텍스트와 다음 Picky 세션에 적용돼요."
          }
        }
      }
    },
    "settings.field.pickyCwd.workspaceWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you use custom instructions in AGENTS.md, copy the file to your new working folder to keep using them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AGENTS.md에 직접 작성한 지침이 있다면 새 작업 폴더에도 복사해 주세요."
          }
        }
