    "settings.remote.entrance.cloudflare": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Tunnel"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Tunnel"
          }
        }
      }
    },
    "settings.remote.entrance.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How other devices, like your phone, reach this Mac. Picky doesn't run a network of its own; it points at the one you set up."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰처럼 다른 기기가 이 Mac에 닿는 경로예요. Picky는 네트워크를 직접 운영하지 않고 사용자가 만든 경로를 가리켜요."
          }
        }
      }
    },
    "settings.remote.entrance.localOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 안 함"
          }
        }
      }
    },
    "settings.remote.entrance.tailscale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale Serve"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale Serve"
          }
        }
      }
    },
    "settings.remote.keepAwake": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent sleep"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자기 방지"
          }
        }
      }
    },
    "settings.remote.keepAwake.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the Mac from sleeping on its own while web access runs. Closing the lid still puts it to sleep."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 접속이 실행되는 동안 Mac이 저절로 잠자기에 들지 않게 해요. 덮개를 닫으면 그래도 잠자기에 들어가요."
          }
        }
      }
    },
    "settings.remote.localOnly.address": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address on this Mac"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac 주소"
          }
        }
      }
    },
    "settings.remote.localOnly.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another browser that opens this address connects with a pairing code."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 브라우저에서 이 주소를 열면 연결 코드로 연결해요."
          }
        }
      }
    },
    "settings.remote.notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A paired device can open this Mac's Pickles and main conversation, send instructions, and run work that includes shell commands. Pair only devices you know, and revoke the ones you no longer use."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결한 기기는 이 Mac의 Pickle과 메인 대화를 열고, 지시를 보내고, 셸 명령이 포함된 작업을 실행할 수 있어요. 아는 기기만 연결하고 쓰지 않는 기기는 연결을 해제해 주세요."
          }
        }
      }
    },
    "settings.remote.pair": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
