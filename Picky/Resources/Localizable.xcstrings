    "settings.dispatch.followUp.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the current turn to finish, then continue."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 응답이 끝난 뒤 이어서 전달해요."
          }
        }
      }
    },
    "settings.dispatch.idle.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to PTT and Quick Input sent to an armed Pickle. Idle Pickles start immediately with either option."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전달 대상으로 지정한 Pickle에 눌러서 말하기·빠른 입력으로 보내는 요청에 적용돼요. 작업 중이 아니면 어느 방식이든 바로 시작해요."
          }
        }
      }
    },
    "settings.dispatch.steer.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send your request during the current work to adjust its direction."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 끝나기 전에 요청을 전달해 진행 방향을 조정해요."
          }
        }
      }
    },
    "settings.field.agentsFile": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AGENTS.md"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AGENTS.md"
          }
        }
      }
    },
    "settings.field.agentsFile.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Picky’s persona and Pickle routing instructions in the workspace’s AGENTS.md. Reset the Picky conversation or restart the app to apply changes to the current conversation."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Picky 작업 폴더의 AGENTS.md에서 말투와 Pickle 작업 배분 지침을 편집해요. 현재 대화에 변경사항을 적용하려면 Picky 대화를 초기화하거나 앱을 재시작해 주세요."
          }
        }
      }
    },
    "settings.field.apiKey": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키"
          }
        }
      }
    },
    "settings.field.armedPickleDispatchMode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivery to the input-target Pickle"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 대상 Pickle에 전달하는 방식"
          }
        }
      }
    },
    "settings.field.armedPickleDispatchMode.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For voice and Quick Input requests sent to the input-target Pickle, choose whether to wait for its response to finish or send during its work. Idle Pickles start immediately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전달 대상으로 지정한 Pickle에 음성이나 빠른 입력을 보낼 때, 응답이 끝날 때까지 기다릴지 작업 중에 전달할지 선택해요. 작업 중이 아니면 바로 시작해요."
          }
        }
      }
    },
    "settings.field.attachScreenshotsOnlyWhenInked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit automatic screenshot sharing"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 화면 전송 제한"
          }
        }
      }
    },
    "settings.field.attachScreenshotsOnlyWhenInked.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, only marked screens are sent automatically. Screens you explicitly include are sent even without marks. Local capture for drawing continues."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 표시한 화면만 자동으로 보내요. 직접 포함한 화면은 표시하지 않아도 전송돼요. 그리기용 화면 캡처는 Mac에서 계속돼요."
          }
        }
      }
    },
    "settings.field.defaultCwd": {
