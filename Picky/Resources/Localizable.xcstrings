    "hub.settings.classification.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI work classification"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 작업 분류"
          }
        }
      }
    },
    "hub.settings.classification.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Off by default."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 기능이며 기본적으로 꺼져 있어요."
          }
        }
      }
    },
    "hub.settings.classification.disclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, Picky sends each eligible Pickle's title, up to five short user-message excerpts, tool names and counts, activity counts, changed-file count, and subagent count to an authenticated model provider allowed by your configured model scope. This may use your model quota or incur provider costs. When off, new work is not sent for classification. Existing classifications and local statistics are retained."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 분류 대상 Pickle의 제목, 짧은 사용자 메시지 발췌 최대 5개, 도구 이름과 사용 횟수, 활동 횟수, 변경 파일 수, 서브에이전트 수를 설정한 모델 범위에서 허용된 인증된 AI 제공업체에 보내요. 모델 사용 한도를 소모하거나 비용이 발생할 수 있어요. 끄면 새 작업을 분류용으로 보내지 않아요. 기존 분류 결과와 이 Mac의 통계는 유지돼요."
          }
        }
      }
    },
    "hub.settings.classification.accessibilityHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available after statistics have loaded."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통계를 불러온 뒤 변경할 수 있어요."
          }
        }
      }
    },
    "hub.settings.classification.saving": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving classification preference…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분류 설정을 저장하는 중…"
          }
        }
      }
    },
