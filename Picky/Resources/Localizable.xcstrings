            "value": "파일 20개를 바꾼 Pickle 완료"
          }
        }
      }
    },
    "hud.toolImage.missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image not found"
          }
        },
        "ko": {
          "stringUnit": {
