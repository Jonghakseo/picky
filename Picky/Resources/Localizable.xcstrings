    "hud.asyncTasks.archiveChoice.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Pickle may have unfinished work. Archive it without stopping, or try to stop it first. If cleanup cannot be confirmed, it will not be archived."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝나지 않은 작업이 있을 수 있어요. 중지하지 않고 보관하거나, 중지를 시도한 뒤 보관할 수 있어요. 정리 결과를 확인할 수 없으면 보관되지 않아요."
          }
        }
      }
    },
    "hud.asyncTasks.archiveChoice.namedTitle": {
      "comment": "Archive confirmation title. Argument is the exact Pickle title displayed in the HUD.",
      "localizations": {
