    "hud.header.target.locked.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picky voice and Quick Input keep going to this Pickle. Click again to unpin, or click another Pickle’s input-target badge to switch. Long-press its badge to pin it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Picky 음성과 빠른 입력을 계속 이 Pickle로 보내요. 고정을 풀려면 다시 클릭하세요. 대상을 바꾸려면 다른 Pickle의 입력 대상 배지를 클릭하고, 고정하려면 그 배지를 길게 누르세요."
          }
        }
      }
    },
