    "settings.field.piBinaryPath.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty to auto-discover with PI_CODING_AGENT_DIR/bin/pi, PATH (`which pi`), then ~/.pi/agent/bin/pi. Used when Picky runs `pi install/remove`; install actions pick it up immediately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워두면 PI_CODING_AGENT_DIR/bin/pi, PATH(`which pi`), ~/.pi/agent/bin/pi 순서로 자동 탐색해요. Picky가 `pi install/remove`를 실행할 때 사용하며, 설치/제거 작업에는 즉시 반영돼요."
          }
        }
      }
    },
