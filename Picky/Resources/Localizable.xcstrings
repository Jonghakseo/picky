    "settings.remote.pair.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a pairing code for a phone or another browser. The code expires after a set time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 코드를 만들어 폰이나 다른 브라우저를 등록해요. 코드는 정해진 시간이 지나면 만료돼요."
          }
