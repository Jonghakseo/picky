    "hud.archivedList.confirmDeleteAllMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All archived Pickles will be permanently deleted, including any still working or waiting for input. Connected work will be stopped. This cannot be undone."
