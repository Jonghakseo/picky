    "shellCommand.stale.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ command at %@ uses a different Picky.app:\n%@\n\nReinstall to use the current app, or uninstall the command."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 명령(%@)이 다른 Picky.app을 사용하고 있어요:\n%@\n\n현재 앱을 사용하려면 다시 설치하세요. 명령을 삭제할 수도 있어요."
          }
        }
      }
    },
    "shellCommand.conflict.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file not managed by Picky already exists at %@. Picky will not overwrite it. To install here, move or rename that file first."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 Picky가 관리하지 않는 파일이 있어 덮어쓰지 않아요. 여기에 설치하려면 기존 파일을 옮기거나 이름을 바꿔 주세요."
          }
        }
      }
    },
    "shellCommand.installed.body": {
      "localizations": {
