    "settings.field.piModel.helpText": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Automatic to follow Pi settings, or pick a model to pin Picky. Reasoning level below is applied with the pinned model."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 설정을 따르려면 자동을 선택하고, 특정 모델을 사용하려면 목록에서 고르세요. 아래 추론 수준은 선택한 모델과 함께 적용돼요."
          }
        }
      }
    },
    "settings.field.pickleModel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickle model"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickle 모델"
          }
        }
      }
    },
    "settings.field.pickleModel.helpText": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only as the initial model for newly-created Pickles. Running Pickles can still cycle models independently."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 생성되는 Pickle의 초기 모델로만 사용돼요. 실행 중인 Pickle은 별도로 모델을 변경할 수 있어요."
          }
        }
      }
    },
    "settings.field.pickyCwd": {
