{
  "name": "empty-message-import-is-noop",
  "description": "An empty messagesImport changes nothing, so it must not promote an omitted journal to 'loaded and empty'. Otherwise a client would render 'no messages yet' for a session whose journal it simply has not received. The transaction's revision still applies.",
  "events": [
    {
      "id": "event-conformance-empty-import-snapshot",
      "protocolVersion": "2026-08-25",
      "timestamp": "2026-08-24T00:00:00.000Z",
      "type": "sessionProjectionSnapshot",
      "sessionId": "session-conformance",
      "epoch": "epoch-conformance",
      "revision": 1,
      "complete": false,
      "omittedFields": ["messages"],
      "projection": {
        "id": "session-conformance",
        "title": "Empty import",
        "status": "running",
        "createdAt": "2026-08-24T00:00:00.000Z",
        "updatedAt": "2026-08-24T00:00:00.000Z"
      }
    },
    {
      "id": "event-conformance-empty-import",
      "protocolVersion": "2026-08-25",
      "timestamp": "2026-08-24T00:00:01.000Z",
      "type": "sessionProjectionTransaction",
      "sessionId": "session-conformance",
      "epoch": "epoch-conformance",
      "baseRevision": 1,
      "revision": 2,
      "mutations": [{ "type": "messagesImport", "messages": [] }]
    }
  ],
  "expect": {
    "sessionPresent": true,
    "signals": { "localPresentationResets": 0, "ignoredTransactions": 0 },
    "sections": {
      "meta": { "state": "loaded", "value": { "revision": 2 } },
      "messages": { "state": "unavailable" },
      "messageJournalAvailable": { "state": "unavailable" }
    }
  }
}
