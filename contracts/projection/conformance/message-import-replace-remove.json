{
  "name": "message-import-replace-remove",
  "description": "Messages are keyed by id. An import upserts without dropping anything, a replace updates in place and keeps the journal position, and a remove deletes only its id.",
  "events": [
    {
      "id": "event-conformance-messages-snapshot",
      "protocolVersion": "2026-08-25",
      "timestamp": "2026-08-24T00:00:00.000Z",
      "type": "sessionProjectionSnapshot",
      "sessionId": "session-conformance",
      "epoch": "epoch-conformance",
      "revision": 1,
      "complete": false,
      "omittedFields": ["messages"],
      "projection": {
        "id": "session-conformance",
        "title": "Journal folding",
        "status": "running",
        "createdAt": "2026-08-24T00:00:00.000Z",
        "updatedAt": "2026-08-24T00:00:00.000Z"
      }
    },
    {
      "id": "event-conformance-messages-empty-import",
      "protocolVersion": "2026-08-25",
      "timestamp": "2026-08-24T00:00:01.000Z",
      "type": "sessionProjectionTransaction",
      "sessionId": "session-conformance",
      "epoch": "epoch-conformance",
      "baseRevision": 1,
      "revision": 2,
      "mutations": [{ "type": "messagesImport", "messages": [] }]
    },
    {
      "id": "event-conformance-messages-import",
      "protocolVersion": "2026-08-25",
      "timestamp": "2026-08-24T00:00:02.000Z",
      "type": "sessionProjectionTransaction",
      "sessionId": "session-conformance",
      "epoch": "epoch-conformance",
      "baseRevision": 2,
      "revision": 3,
      "mutations": [
        {
          "type": "messagesImport",
          "messages": [
            { "id": "m1", "kind": "user_text", "createdAt": "2026-08-24T00:00:02.000Z", "text": "first" },
            { "id": "m2", "kind": "agent_text", "createdAt": "2026-08-24T00:00:03.000Z", "text": "second" }
          ]
        }
      ]
    },
    {
      "id": "event-conformance-messages-replace-remove",
      "protocolVersion": "2026-08-25",
      "timestamp": "2026-08-24T00:00:04.000Z",
      "type": "sessionProjectionTransaction",
      "sessionId": "session-conformance",
      "epoch": "epoch-conformance",
      "baseRevision": 3,
      "revision": 4,
      "mutations": [
        {
          "type": "messageReplace",
          "messageId": "m1",
          "message": { "id": "m1", "kind": "user_text", "createdAt": "2026-08-24T00:00:02.000Z", "text": "first, edited" }
        },
        { "type": "messageRemove", "messageId": "m2" }
      ]
    }
  ],
  "expect": {
    "sessionPresent": true,
    "signals": { "localPresentationResets": 0, "ignoredTransactions": 0 },
    "sections": {
      "meta": { "state": "loaded", "value": { "revision": 4 } },
      "messages": { "state": "loaded", "value": [{ "id": "m1", "text": "first, edited" }] },
      "messageJournalAvailable": { "state": "unavailable" }
    }
  }
}
