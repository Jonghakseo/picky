{
  "name": "tool-set-replaces-collection",
  "description": "toolsSet is authoritative. The daemon emits it instead of upserts whenever a tool disappeared, so nothing from the previous collection may survive it.",
  "events": [
    {
      "id": "event-conformance-tool-set-snapshot",
      "protocolVersion": "2026-08-25",
      "timestamp": "2026-08-24T00:00:00.000Z",
      "type": "sessionProjectionSnapshot",
      "sessionId": "session-conformance",
      "epoch": "epoch-conformance",
      "revision": 1,
      "complete": true,
      "omittedFields": [],
      "projection": {
        "id": "session-conformance",
        "title": "Tool folding",
        "status": "running",
        "createdAt": "2026-08-24T00:00:00.000Z",
        "updatedAt": "2026-08-24T00:00:00.000Z",
        "tools": [
          { "toolCallId": "tool-a", "name": "Read", "status": "succeeded" },
          { "toolCallId": "tool-b", "name": "Grep", "status": "running" }
        ]
      }
    },
    {
      "id": "event-conformance-tool-set",
      "protocolVersion": "2026-08-25",
      "timestamp": "2026-08-24T00:00:02.000Z",
      "type": "sessionProjectionTransaction",
      "sessionId": "session-conformance",
